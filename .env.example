# Neon Postgres — pooled connection string.
# Neon dashboard → your project → Connection Details → "Pooled connection".
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Sepolia JSON-RPC endpoint. A free public node works and needs no signup:
#   https://ethereum-sepolia-rpc.publicnode.com
# Hosted providers are more reliable under load:
# e.g. https://sepolia.infura.io/v3/<id>, https://eth-sepolia.g.alchemy.com/v2/<key>
SEPOLIA_RPC_URL=

# Private key of a THROWAWAY wallet holding a little Sepolia ETH.
# It signs the anchoring transactions. Never use a key that holds real funds.
# `npm run wallet:new` generates one and writes it here without printing it.
# Faucet with no mainnet-balance requirement, just a Google account:
#   https://cloud.google.com/application/web3/faucet/ethereum/sepolia
WALLET_PRIVATE_KEY=

# Reverse image search — chapter 03 needs at least one of these, since Lens is now
# the only thing that looks anything up. Set either or both; they are tried in this
# order until one answers, so exhausting one vendor's free tier does not take the
# chapter down.
#   SearchApi.io  100 credits, one time     https://www.searchapi.io/ → API keys
#   SerpApi       250 searches/month, reset https://serpapi.com/ → Your Account
# Both need Google to fetch the crop from /api/img/<hash>, so they only work on
# a publicly reachable origin. On localhost the route returns 409 and says so.
SEARCHAPI_KEY=
SERPAPI_KEY=

# Optional — canonical origin used for Open Graph image URLs. On Vercel this is
# inferred automatically; set it only for a custom domain or self-hosting.
NEXT_PUBLIC_SITE_URL=
